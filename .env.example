# MEA-Core V3 Configuration
# Copia este archivo como .env y completa tus valores

# === API Keys ===
# Obtén tu API key desde https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# === Redis ===
# URL del broker Redis (usa redis://localhost:6379 si es local)
REDIS_URL=redis://localhost:6379

# === Modelos Locales ===
# Ruta al modelo GGUF (descárgalo desde huggingface.co)
LLM_MODEL_PATH=./models/model.gguf
LLM_MODEL_NAME=Qwen2.5-1.5B-Instruct-Q4_K_M

# === Configuración del Agente ===
# Contexto máximo para el LLM
MAX_TOKENS=2048
# Temperatura de generación (0.0-1.0)
TEMPERATURE=0.7

# === Puerto ===
# Puerto para el servidor API
PORT=8000

# === Modo ===
# 'local' = solo modelo local, 'hybrid' = local + API, 'api' = solo API
RUN_MODE=hybrid